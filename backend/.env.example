PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/auto_recover_ai
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Provider: groq | gemini | heuristic
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

AI_MAX_RETRIES=3
AI_FALLBACK_ON_QUOTA=true
BATCH_DELAY_MS=800
CONFIDENCE_THRESHOLD=0.85
MAX_RETRIES=3

# Optional: real WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEFAULT_WHATSAPP_TO=

# Razorpay test mode — payment links for recovery
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Bland.ai voice agent fallback
BLAND_API_KEY=
BLAND_VOICE=maya
