PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/auto_recover_ai

# Provider: groq | gemini | heuristic  (auto-picks groq → gemini → heuristic if unset)
AI_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional fallback / alternate
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

AI_MAX_RETRIES=3
AI_FALLBACK_ON_QUOTA=true
BATCH_DELAY_MS=800
CONFIDENCE_THRESHOLD=0.85
MAX_RETRIES=3
